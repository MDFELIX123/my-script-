        _GM_setValue('pendingCountdown', pendingCountdown);
        try { localStorage.setItem('fbHitHistory', JSON.stringify(hitHistory)); } catch (_) {}
    }

    function setNativeValue(element, value) {
        if (!element) return;
        try {
            const prototype = Object.getPrototypeOf(element);
            const descriptor = Object.getOwnPropertyDescriptor(prototype, 'value') || Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value');
            if (descriptor && descriptor.set) descriptor.set.call(element, value);
            else element.value = value;
        } catch (_) { element.value = value; }
    }

    function typeFast(el, text) {
        if (!el) return;
        el.focus();
        setNativeValue(el, text);
        try { el.dispatchEvent(new InputEvent('input', { bubbles: true, cancelable: true, data: String(text) })); } catch (_) { el.dispatchEvent(new Event('input', { bubbles: true })); }
        el.dispatchEvent(new Event('change', { bubbles: true }));
        el.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true, key: text.slice(-1) }));
        el.dispatchEvent(new Event('blur', { bubbles: true }));
    }

    function clickFast(el) {
        if (!el) return;
        try {
            el.focus();
            el.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
            el.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true }));
            el.click();
        } catch (_) { el.click(); }
    }

    function getSubmitButton() {
        const candidates = ['button[name="websubmit"]', 'button[type="submit"]', '#signup_button', 'button[id*="submit"]', 'button[data-testid="royal_login_button"]', 'form button:not([id*="fb"]):not([id*="binary"]):not([id*="startBtn"])', 'form input[type="submit"]'];
        for (const sel of candidates) {
            const matches = document.querySelectorAll(sel);
            for (const el of matches) {
                if (el.closest('#fbx') || el.closest('#binary-screen') || el.closest('#typeme-top-pill')) continue;
                if (el.offsetParent !== null && !el.disabled) return el;
            }
        }
        return null;
    }

    function getPF() {
        const candidates = ['input[name="reg_email__"]', 'input[name="email"]', 'input[id="email"]', 'input[type="tel"]', 'input[autocomplete="tel"]', 'input[autocomplete="username"]', 'input[aria-label*="Mobile" i]', 'input[aria-label*="Phone" i]', 'input[aria-label*="email" i]', 'input[name*="phone" i]'];
        for (const sel of candidates) {
            const el = document.querySelector(sel);
            if (el && !el.closest('#fbx') && el.offsetParent !== null) return el;
        }
        return null;
    }

    function getPW() {
        const candidates = ['input[name="reg_passwd__"]', 'input[name="pass"]', 'input[id="pass"]', 'input[type="password"]', 'input[autocomplete="current-password"]', 'input[autocomplete="new-password"]'];
        for (const sel of candidates) {
            const el = document.querySelector(sel);
            if (el && !el.closest('#fbx') && el.offsetParent !== null) return el;
        }
        return null;
    }

    function fillAuxiliaryFields() {
        const fn = document.querySelector('input[name="firstname"]');
        const ln = document.querySelector('input[name="lastname"]');
        if (fn && !fn.value) typeFast(fn, 'Alex');
        if (ln && !ln.value) typeFast(ln, 'Taylor');
    }

    function addHit(phone) {
        const exists = hitHistory.some(h => h.phone === phone);
        if (!exists) {
            hitHistory.unshift({ phone: phone, time: new Date().toLocaleTimeString() });
            if (hitHistory.length > 500) hitHistory.pop();
            save();
        }
        refreshHistory();
        updateStats();
    }

    function refreshHistory() {
        const hl = document.getElementById('hitlist');
        if (!hl) return;
        if (hitHistory.length === 0) hl.innerHTML = '<div style="color:#666;font-size:9px;text-align:center;padding:6px;">No hits yet</div>';
        else hl.innerHTML = hitHistory.map((h, i) => '<div style="color:#ff6b6b;font-size:9px;padding:2px 4px;border-bottom:1px solid #220000;display:flex;justify-content:space-between;"><span>' + (i+1) + '. ' + h.phone + '</span><span style="color:#888;">' + h.time + '</span></div>').join('');
        const hb = document.getElementById('histBtn');
        if (hb) hb.textContent = 'HITS: ' + hitHistory.length;
    }

    function downloadHits() {
        if (hitHistory.length === 0) { log('No hits to export', '#f80'); return; }
        const text = hitHistory.map((h, i) => (i + 1) + '. ' + h.time + ': ' + h.phone).join('\n');
        const blob = new Blob([text], { type: 'text/plain' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'fb_hits_' + Date.now() + '.txt';
        a.click();
        log('Downloaded ' + hitHistory.length + ' hits', '#0f0');
    }

    function safeAppend(element) {
        if (document.body) document.body.appendChild(element);
        else if (document.documentElement) document.documentElement.appendChild(element);
        else window.addEventListener('DOMContentLoaded', () => { (document.body || document.documentElement).appendChild(element); });
    }

