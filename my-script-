                        <span>📞 <span id="phoneDisplay">${COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0')}</span></span>
                        <span>Progress: <span id="progressDisplay">[░░░░░░░░░░] 0%</span></span>
                    </div>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:2px;font-size:9px;color:#ff0;">
                        <span>Hits: <span id="hitsDisplay">${hits}</span></span>
                        <span>Created: <span id="createdDisplay">${created}</span></span>
                        <span>Left: <span id="leftDisplay">${(MAX_NUMBER + 1) - currentNumber}</span></span>
                    </div>
                    <div style="flex:1;display:flex;flex-direction:column;min-width:0;">
                        <div style="color:#888;font-size:8px;margin-bottom:2px;">LIVE LOG</div>
                        <div id="fbl" style="flex:1;overflow-y:auto;background:#050505;padding:3px;border:1px solid#222;"></div>
                    </div>
                </div>
            </div>
            <div style="border-top:1px solid#0f0;margin-top:3px;padding-top:3px;color:#ff0;font-size:8px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
                H:<span id="hc">${hits}</span> C:<span id="cc">${created}</span> #<span id="cl">${currentNumber}</span> PREF:<span id="pl">${PREFIX}</span>
                DELAY:<span id="sd">${stepDelay}</span>ms
                CC:<input id="ci" value="${COUNTRY_CODE}" style="width:35px;background:#000;color:#0f0;border:1px solid#0f0;padding:1px;font-size:8px;">
                PREF:<input id="pi" value="${PREFIX}" style="width:55px;background:#000;color:#0f0;border:1px solid#0f0;padding:1px;font-size:8px;">
                PW:<input id="pwi" value="${PASSWORD}" style="width:50px;background:#000;color:#0f0;border:1px solid#0f0;padding:1px;font-size:8px;">
                #:<input id="ni" value="${currentNumber}" style="width:30px;background:#000;color:#0f0;border:1px solid#0f0;padding:1px;font-size:8px;">
                LIM:<input id="li" value="${rateLimitWait}" style="width:35px;background:#000;color:#f80;border:1px solid#f80;padding:1px;font-size:8px;">ms
                <button id="ap" style="padding:2px 8px;background:#080;color:#000;border:none;font-size:8px;cursor:pointer;">APPLY</button>
                <span id="as" style="color:#ff0;"></span>
            </div>
        `;
        document.body.appendChild(d);

        installCtrlListener();

        document.getElementById('startBtn').addEventListener('click', function() {
            if (loopStarted) {
                loopStarted = false; GM_setValue('autoResume', false); save();
                this.textContent = 'START'; this.style.color = '#0f0';
                log('⏹ STOPPED', '#ff0');
                document.getElementById('statusText').textContent = 'STOPPED';
                document.getElementById('statusDot').style.color = '#888';
                return;
            }
            loopStarted = true; GM_setValue('autoResume', false); save();
            this.textContent = 'STOP'; this.style.color = '#f00';
            log('🚀 SONIC STARTED', '#0ff');
            document.getElementById('statusText').textContent = 'RUNNING';
            document.getElementById('statusDot').style.color = '#0f0';
            loop();
        });

        document.getElementById('dlBtn').addEventListener('click', downloadHits);
        document.getElementById('clrBtn').addEventListener('click', () => {
            if (confirm('Clear all ' + hitHistory.length + ' hits?')) {
                hitHistory = []; save(); refreshHistory();
                document.getElementById('histBtn').textContent = 'HITS: 0'; updateStats();
            }
        });

        document.getElementById('panelVoiceBtn').addEventListener('click', function() {
            voiceEnabled = !voiceEnabled;
            save();
            let vo2 = voiceEnabled ? 'ON' : 'OFF';
            let vc2 = voiceEnabled ? '#0f0' : '#f00';
            this.textContent = '🔊 ' + vo2;
            this.style.color = vc2;
            this.style.borderColor = vc2;
        });

        document.getElementById('ap').addEventListener('click', () => {
            COUNTRY_CODE = document.getElementById('ci').value.trim() || '+234';
            PREFIX = document.getElementById('pi').value.trim() || '9053237';
            PASSWORD = document.getElementById('pwi').value.trim() || PASSWORD;
            let nn = parseInt(document.getElementById('ni').value);
            if (nn >= 0 && nn <= MAX_NUMBER) currentNumber = nn;
            let rl = parseInt(document.getElementById('li').value);
            if (rl >= 0 && rl <= 60000) rateLimitWait = rl;
            GM_setValue('autoResume', false); save();
            document.getElementById('as').textContent = 'OK'; updateStats();
            setTimeout(() => location.reload(), 400);
        });

        if (loopStarted && GM_getValue('autoResume', false)) {
            GM_setValue('autoResume', false); save();
            document.getElementById('startBtn').textContent = 'STOP';
            document.getElementById('startBtn').style.color = '#f00';
            document.getElementById('statusText').textContent = 'RUNNING';
            document.getElementById('statusDot').style.color = '#0f0';
            log('🔄 Auto-resumed after refresh', '#0ff');

            if (pendingCountdown) {
                let phone = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
                countdown54321(phone);
                setTimeout(() => { loop(); }, 5200);
            } else {
                loop();
            }
        } else if (loopStarted) {
            loopStarted = false; save();
        }

        refreshHistory();
        updateStats();
    }

    function log(msg, c) {
        c = c || '#0f0';
        createPanel();
        let l = document.getElementById('fbl');
        if (!l) return;
        let e = document.createElement('div');
        e.style.color = c;
        e.textContent = '[' + new Date().toLocaleTimeString() + '] ' + msg;
        l.prepend(e);
        while (l.children.length > 80) l.lastChild.remove();
        updateStats();
    }

    function u() {
        let hc = document.getElementById('hc'), cc = document.getElementById('cc'), cl = document.getElementById('cl'), pl = document.getElementById('pl'), sd = document.getElementById('sd');
        if (hc) hc.textContent = hits;
        if (cc) cc.textContent = created;
        if (cl) cl.textContent = currentNumber;
        if (pl) pl.textContent = PREFIX;
        if (sd) sd.textContent = stepDelay;
        updateStats();
    }

    function wait(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

    function typeFast(el, text) {
        el.focus();
        el.value = text;
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function clickFast(el) { el.click(); }

    function closePopup() {
        let all = document.querySelectorAll('button, a, div[role="button"], span');
        for (let el of all) {
            let text = el.textContent || '';
            if (text.trim().toLowerCase() === 'close' && el.offsetParent) {
                el.click();
                return true;
            }
        }
        return false;
    }

    function getPF() {
        return document.querySelector('input[name="reg_email__"]') ||
               document.querySelector('input[aria-label*="Mobile"]') ||
               document.querySelector('input[aria-label*="email"]') ||
               document.querySelector('input[aria-label*="number"]');
    }

    function getPW() { return document.querySelector('input[type="password"]'); }

    async function step() {
        if (!loopStarted || working || paused) return;

        if (currentNumber > MAX_NUMBER) {
            let oldPref = PREFIX;
            PREFIX = String(parseInt(PREFIX) + 1);
            PASSWORD = PREFIX;
            currentNumber = 0;
            save();
            log('🔄 PREFIX: ' + oldPref + ' -> ' + PREFIX, '#ff0');
            log('🔑 PW updated: ' + PASSWORD, '#ff0');
            u();
            return;
        }

        let phone = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
        let body = document.body.innerText;
        let url = location.href;

        if (!url.includes('signup') && url.includes('facebook.com')) {
            created++; GM_setValue('autoResume', false); save();
            log('✅ CREATED: ' + phone, '#0f0');
            document.getElementById('statusText').textContent = 'CREATED!';
            document.getElementById('statusDot').style.color = '#0f0';
            loopStarted = false; save();
            showBinaryScreen(phone, PASSWORD);
            return;
        }

        if (body.includes("You Can't Use This Feature") || body.includes("going too fast") || body.includes("significantly slow down")) {
            log('⛔ RATE LIMIT! Waiting ' + rateLimitWait + 'ms...', '#f00');
            document.getElementById('statusText').textContent = 'LIMIT';
            document.getElementById('statusDot').style.color = '#f00';
            closePopup();
            working = true;
            await wait(rateLimitWait);
            working = false;
            document.getElementById('statusText').textContent = 'RUNNING';
            document.getElementById('statusDot').style.color = '#0f0';
            u();
            return;
        }

        if (body.includes('Something went wrong') || body.includes('Sorry, something went wrong')) {
            closePopup();
            await wait(100);
            let newUrl = location.href;
            if (!newUrl.includes('signup') && newUrl.includes('facebook.com')) {
                created++; GM_setValue('autoResume', false); save();
                log('✅ CREATED: ' + phone, '#0f0');
                document.getElementById('statusText').textContent = 'CREATED!';
                document.getElementById('statusDot').style.color = '#0f0';
                loopStarted = false; save();
                showBinaryScreen(phone, PASSWORD);
            } else {
                log('🔴 HIT: ' + phone, '#f44');
                document.getElementById('statusText').textContent = 'HIT!';
                document.getElementById('statusDot').style.color = '#f00';
                addHit(phone);
                hits++;
                currentNumber++;

                pendingCountdown = true;
                GM_setValue('pendingCountdown', true);
                GM_setValue('autoResume', true);
                GM_setValue('loopStarted', true);
                loopStarted = true;
                save();
                u();

                log('🔄 Refreshing page...', '#0ff');
                setTimeout(() => { location.reload(); }, 300);
            }
            return;
        }

        if (lastSubmitted === phone && !body.includes('Something went wrong') && !body.includes('Sorry')) {
            log('⏭️ SKIP: ' + phone, '#888');
            currentNumber++;
            save();
            u();
            lastSubmitted = '';
            return;
        }

        closePopup();

        let pf = getPF();
        let pw = getPW();
        if (!pf || !pw) {
            if (!url.includes('signup')) {
                log('🔄 Redirecting to signup...', '#aaa');
                window.location.href = 'https://business.facebook.com/signup';
            }
            return;
        }

        working = true;
        lastSubmitted = phone;
        attempts++;
        pf.value = '';
        pw.value = '';

        clickFast(pf);
        typeFast(pf, phone);
        clickFast(pw);
        typeFast(pw, PASSWORD);

        let btn = document.querySelector('button[name="websubmit"]') ||
                  document.querySelector('button[type="submit"]') ||
                  document.querySelector('button');
        if (btn && btn.offsetParent) {
            clickFast(btn);
            log('📤 ' + phone, '#aaa');
        }

        working = false;
        await wait(5);
    }

    async function loop() {
        while (loopStarted) {
            await step();
            await wait(10);
        }
    }

    let curUrl = location.href;
    if (!curUrl.includes('signup') && curUrl.includes('facebook.com') && GM_getValue('loopStarted', false)) {
        let phone = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
        created++; GM_setValue('created', created);
        GM_setValue('loopStarted', false); GM_setValue('autoResume', false); save();
        setTimeout(() => { showBinaryScreen(phone, PASSWORD); }, 500);
    }

    createPanel();
    log('⚡ SONIC v2 FINAL | 🌍 ' + getCountryName(COUNTRY_CODE), '#0f0');
    log('📞 ' + PREFIX + ' | 🔑 ' + PASSWORD, '#0ff');
    log('🔊 Voice: ' + (voiceEnabled ? 'ON' : 'OFF'), voiceEnabled ? '#0f0' : '#f00');
    log('⌨️ Tap CTRL to hide/show panel', '#0ff');
})();
