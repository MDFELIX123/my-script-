(function() {
    'use strict';

    const ACTIVATED = GM_getValue('activated', '');

    function showActivationScreen() {
        if (document.getElementById('activation-box')) return;
        let box = document.createElement('div');
        box.id = 'activation-box';
        box.style.cssText = `
            position:fixed; top:0; left:0; right:0; bottom:0;
            background:#000; color:#0f0; z-index:999999;
            display:flex; align-items:center; justify-content:center;
            font:14px monospace; text-align:center;
        `;
        let sm = ACTIVATED === 'yes' ? '✅ Active — Permanent' : '🔒 Click ACTIVATE to unlock';
        let sc = ACTIVATED === 'yes' ? '#0f0' : '#ff0';
        box.innerHTML = `
            <div style="background:#0a0a0a;padding:40px;border:2px solid #0f0;border-radius:10px;max-width:400px;box-shadow:0 0 30px #0f0;">
                <b style="color:#0f0;font-size:20px;">🔐 SCRIPT ACTIVATION</b><br><br>
                <div style="color:#888;font-size:12px;">Click ACTIVATE to unlock</div><br>
                <div style="color:${sc};font-size:16px;font-weight:bold;">${sm}</div><br>
                <button id="activate-btn" style="padding:12px 40px;background:#0f0;color:#000;border:none;font-weight:bold;font-size:16px;cursor:pointer;border-radius:5px;">🔓 ACTIVATE</button>
                <div id="activation-msg" style="margin-top:15px;color:#f00;font-size:12px;"></div>
            </div>
        `;
        document.body.appendChild(box);
        document.getElementById('activate-btn').addEventListener('click', function() {
            if (ACTIVATED === 'yes') {
                document.getElementById('activation-msg').textContent = '⚠️ Already activated';
                document.getElementById('activation-msg').style.color = '#ff0';
                return;
            }
            GM_setValue('activated', 'yes');
            document.getElementById('activation-msg').textContent = '✅ Activated!';
            document.getElementById('activation-msg').style.color = '#0f0';
            this.disabled = true; this.style.opacity = '0.5';
            setTimeout(() => { document.getElementById('activation-box').remove(); location.reload(); }, 1000);
        });
    }

    if (ACTIVATED !== 'yes') { showActivationScreen(); return; }

