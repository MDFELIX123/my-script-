    function updateStats() {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const hours = String(Math.floor(elapsed / 3600)).padStart(2, '0');
        const minutes = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
        const seconds = String(elapsed % 60).padStart(2, '0');

        const td = document.getElementById('timerDisplay'); if (td) td.textContent = hours + ':' + minutes + ':' + seconds;
        const sd = document.getElementById('speedDisplay'); if (sd) { const s = Math.round(attempts / ((elapsed || 1) / 60)) || 0; sd.textContent = s + '/min'; }
        const pd = document.getElementById('phoneDisplay'); if (pd) pd.textContent = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
        const pp = document.getElementById('progressDisplay');
        if (pp) {
            const prog = Math.min(100, Math.round((currentNumber / (MAX_NUMBER + 1)) * 100));
            const filled = Math.min(20, Math.floor(prog / 5));
            const bar = '█'.repeat(filled) + '░'.repeat(20 - filled);
            pp.textContent = '[' + bar + '] ' + prog + '% (' + currentNumber + '/' + (MAX_NUMBER + 1) + ')';
        }
        const hd = document.getElementById('hitsDisplay'); if (hd) hd.textContent = String(hits);
        const cd = document.getElementById('createdDisplay'); if (cd) cd.textContent = String(created);
        const ld = document.getElementById('leftDisplay'); if (ld) ld.textContent = String(Math.max(0, (MAX_NUMBER + 1) - currentNumber));
    }

    function createPanel() {
        if (document.getElementById('fbx')) return;
        const d = document.createElement('div');
        d.id = 'fbx';
        d.style.cssText =
            'position:fixed !important;bottom:0 !important;left:0 !important;right:0 !important;height:240px !important;background:#050505 !important;color:#00ff66 !important;z-index:2147483640 !important;font:11px "Courier New",monospace !important;padding:6px !important;border-top:3px solid #00ff66 !important;display:flex !important;flex-direction:column !important;box-shadow:0 -5px 25px rgba(0,0,0,0.9) !important;';

        const country = getCountryName(COUNTRY_CODE);
        const vo = voiceEnabled ? 'ON' : 'OFF';
        const vc = voiceEnabled ? '#00ff66' : '#ff4444';

        d.innerHTML =
            '<div style="display:flex;align-items:center;margin-bottom:4px;gap:6px;flex-wrap:wrap;background:#111;padding:4px 8px;border-radius:4px;">' +
            '  <b style="color:#00ff66;font-size:12px;">⚡ FB SONIC v25.4 (7s + Voice)</b>' +
            '  <span id="statusDot" style="color:#888;">⚪</span>' +
            '  <span id="statusText" style="color:#00ff66;font-weight:bold;">READY</span>' +
            '  <span style="color:#555;">|</span>' +
            '  <span style="color:#38bdf8;">⏱️ <span id="timerDisplay">00:00:00</span></span>' +
            '  <span style="color:#555;">|</span>' +
            '  <span style="color:#eab308;">⚡ <span id="speedDisplay">0/min</span></span>' +
            '  <span style="color:#555;">|</span>' +
            '  <span style="color:#c084fc;">🌍 <span id="countryDisplay">' + country + '</span></span>' +
            '  <span style="color:#777;font-size:10px;">(Ctrl hides)</span>' +
            '  <div style="margin-left:auto;display:flex;gap:6px;align-items:center;">' +
            '    <button id="startBtn" style="padding:4px 14px;background:#00ff66;color:#000;border:none;font-weight:bold;cursor:pointer;border-radius:4px;">START</button>' +
            '    <button id="dlBtn" title="Download Hits" style="padding:4px 8px;background:#1e293b;color:#00ff66;border:1px solid #334155;cursor:pointer;border-radius:4px;">📥</button>' +
            '    <button id="clrBtn" title="Clear History" style="padding:4px 8px;background:#1e293b;color:#f87171;border:1px solid #334155;cursor:pointer;border-radius:4px;">🗑</button>' +
            '    <button id="panelVoiceBtn" style="padding:4px 8px;background:#1e293b;color:' + vc + ';border:1px solid #334155;cursor:pointer;border-radius:4px;">🔊 ' + vo + '</button>' +
            '    <span id="histBtn" style="color:#f87171;font-weight:bold;padding-left:4px;">HITS: ' + hitHistory.length + '</span>' +
            '  </div>' +
            '</div>' +
            '<div style="display:flex;flex:1;gap:6px;min-height:0;">' +
            '  <div style="flex:2;display:flex;flex-direction:column;min-width:0;">' +
            '    <div style="display:flex;gap:12px;margin-bottom:4px;font-size:11px;">' +
            '      <span>📞 <b id="phoneDisplay" style="color:#38bdf8;">' + COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0') + '</b></span>' +
            '      <span id="progressDisplay" style="color:#a3e635;">[░░░░░░░░░░] 0%</span>' +
            '      <span style="color:#fbbf24;">Hits: <b id="hitsDisplay">' + hits + '</b></span>' +
            '      <span style="color:#4ade80;">Created: <b id="createdDisplay">' + created + '</b></span>' +
            '      <span style="color:#94a3b8;">Left: <b id="leftDisplay">' + ((MAX_NUMBER + 1) - currentNumber) + '</b></span>' +
            '    </div>' +
            '    <div id="fbl" style="flex:1;overflow-y:auto;background:#000;padding:4px;border:1px solid #1e293b;border-radius:4px;font-size:10px;"></div>' +
            '  </div>' +
            '  <div style="flex:1;display:flex;flex-direction:column;min-width:0;border-left:1px solid #1e293b;padding-left:6px;">' +
            '    <div style="color:#888;font-size:10px;margin-bottom:2px;font-weight:bold;">HIT HISTORY (LOG)</div>' +
            '    <div id="hitlist" style="flex:1;overflow-y:auto;background:#000;border:1px solid #1e293b;border-radius:4px;padding:3px;"></div>' +
            '  </div>' +
            '</div>' +
            '<div style="border-top:1px solid #1e293b;margin-top:4px;padding-top:4px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:10px;color:#94a3b8;">' +
            '  CC:<input id="ci" value="' + COUNTRY_CODE + '" style="width:40px;background:#0a0a0a;color:#00ff66;border:1px solid #334155;padding:1px 3px;border-radius:2px;">' +
            '  PREF:<input id="pi" value="' + PREFIX + '" style="width:70px;background:#0a0a0a;color:#00ff66;border:1px solid #334155;padding:1px 3px;border-radius:2px;">' +
            '  PW:<input id="pwi" value="' + PASSWORD + '" style="width:75px;background:#0a0a0a;color:#00ff66;border:1px solid #334155;padding:1px 3px;border-radius:2px;">' +
            '  #:<input id="ni" value="' + currentNumber + '" style="width:36px;background:#0a0a0a;color:#00ff66;border:1px solid #334155;padding:1px 3px;border-radius:2px;">' +
            '  LIM:<input id="li" value="' + rateLimitWait + '" style="width:44px;background:#0a0a0a;color:#f59e0b;border:1px solid #334155;padding:1px 3px;border-radius:2px;">ms' +
            '  STEP:<input id="sdi" value="' + stepDelay + '" style="width:40px;background:#0a0a0a;color:#38bdf8;border:1px solid #334155;padding:1px 3px;border-radius:2px;">ms' +
            '  <button id="ap" style="padding:2px 10px;background:#0284c7;color:#fff;border:none;cursor:pointer;border-radius:2px;font-weight:bold;">APPLY</button>' +
            '  <span id="as" style="color:#00ff66;"></span>' +
            '</div>';

        safeAppend(d);
        installCtrlListener();
        ensureTopPill();

        document.getElementById('startBtn')?.addEventListener('click', function() {
            if (loopStarted) {
                loopStarted = false;
                _GM_setValue('autoResume', false);
                save();
                this.textContent = 'START';
                this.style.background = '#00ff66';
                this.style.color = '#000';
                log('⏹ LOOP STOPPED BY USER', '#ffbb00');
                const st = document.getElementById('statusText');
                const sd = document.getElementById('statusDot');
                if (st) st.textContent = 'STOPPED';
                if (sd) { sd.textContent = '⚪'; sd.style.color = '#888'; }
                return;
            }
            loopStarted = true;
            _GM_setValue('autoResume', false);
            save();
            this.textContent = 'STOP';
            this.style.background = '#ef4444';
            this.style.color = '#fff';
            log('🚀 SONIC LOOP STARTED', '#00ff66');
            const st = document.getElementById('statusText');
            const sd = document.getElementById('statusDot');
            if (st) st.textContent = 'RUNNING';
            if (sd) { sd.textContent = '🟢'; sd.style.color = '#00ff66'; }
            loop();
        });

        document.getElementById('dlBtn')?.addEventListener('click', downloadHits);
        document.getElementById('clrBtn')?.addEventListener('click', () => {
            if (confirm('Clear all logged hits?')) {
                hitHistory = [];
                save();
                refreshHistory();
                updateStats();
            }
        });

        document.getElementById('panelVoiceBtn')?.addEventListener('click', function() {
            voiceEnabled = !voiceEnabled;
            save();
            const vo2 = voiceEnabled ? 'ON' : 'OFF';
            const vc2 = voiceEnabled ? '#00ff66' : '#ef4444';
            this.textContent = '🔊 ' + vo2;
            this.style.color = vc2;
        });

        document.getElementById('ap')?.addEventListener('click', () => {
            COUNTRY_CODE = (document.getElementById('ci')?.value || '+234').trim();
            PREFIX = (document.getElementById('pi')?.value || '9053237').trim();
            PASSWORD = (document.getElementById('pwi')?.value || PASSWORD).trim();
            const nn = parseInt(document.getElementById('ni')?.value || '0', 10);
            if (!isNaN(nn) && nn >= 0 && nn <= MAX_NUMBER) currentNumber = nn;
            const rl = parseInt(document.getElementById('li')?.value || '1500', 10);
            if (!isNaN(rl) && rl >= 0) rateLimitWait = rl;
            const sdVal = parseInt(document.getElementById('sdi')?.value || '0', 10);
            if (!isNaN(sdVal) && sdVal >= 0) stepDelay = sdVal;

            _GM_setValue('autoResume', false);
            save();
            
            const cDisplay = document.getElementById('countryDisplay');
            if (cDisplay) cDisplay.textContent = getCountryName(COUNTRY_CODE);
            
            updateStats();

            const as = document.getElementById('as');
            if (as) as.textContent = '✓ Saved & Updated';
            setTimeout(() => { if (as) as.textContent = ''; }, 2000);
        });

        refreshHistory();
        updateStats();
    }

    function log(msg, c) {
        c = c || '#00ff66';
        createPanel();
        const l = document.getElementById('fbl');
        if (!l) return;
        const e = document.createElement('div');
        e.style.color = c;
        e.style.marginBottom = '1px';
        e.textContent = '[' + new Date().toLocaleTimeString() + '] ' + msg;
        l.prepend(e);
        while (l.children.length > 100) {
            l.lastChild?.remove();
        }
        updateStats();
    }

    function wait(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function closePopup() {
        const buttons = document.querySelectorAll('button, div[role="button"], span');
        for (const el of buttons) {
            if (el.closest('#fbx') || el.closest('#binary-screen') || el.closest('#typeme-top-pill')) continue;
            const text = (el.textContent || '').trim().toLowerCase();
            if ((text === 'close' || text === 'not now' || text === 'ok' || text === 'dismiss') && el.offsetParent) {
                el.click();
                return true;
            }
        }
        return false;
    }

    async function step() {
        if (!loopStarted || working || paused) return;

        if (currentNumber > MAX_NUMBER) {
            const oldPref = PREFIX;
            PREFIX = String(parseInt(PREFIX, 10) + 1);
            PASSWORD = PREFIX;
            currentNumber = 0;
            save();
            log('🔄 PREFIX ROLLED: ' + oldPref + ' -> ' + PREFIX, '#ffbb00');
            log('🔑 New Password: ' + PASSWORD, '#ffbb00');
            updateStats();
            return;
        }

        const phone = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
        const body = (document.body ? document.body.innerText : '') || '';
        const url = window.location.href;

        // Force English Locale to prevent translation
        if (url.includes('facebook.com') && !url.includes('locale=')) {
            window.location.href = url.includes('?') ? url + '&locale=en_US' : url + '?locale=en_US';
            return;
        }

        if (!url.includes('signup') && !url.includes('r.php') && url.includes('facebook.com') && attempts > 0) {
            created++;
            _GM_setValue('autoResume', false);
            save();
            log('✅ ACCOUNT DISCOVERED / REDIRECTED: ' + phone, '#00ff66');
            const st = document.getElementById('statusText');
            if (st) st.textContent = 'CREATED!';
            loopStarted = false;
            save();
            showBinaryScreen(phone, PASSWORD);
            return;
        }

        if (body.includes("You Can't Use This Feature") ||
            body.includes("going too fast") ||
            body.includes("significantly slow down") ||
            body.includes("Try again later")) {
            log('⛔ RATE LIMIT ENCOUNTERED. Cooling down for ' + rateLimitWait + 'ms...', '#ef4444');
            const st = document.getElementById('statusText');
            const sd = document.getElementById('statusDot');
            if (st) st.textContent = 'RATE-LIMIT';
            if (sd) sd.style.color = '#ef4444';
            closePopup();
            working = true;
            await wait(rateLimitWait);
            working = false;
            if (st) st.textContent = 'RUNNING';
            if (sd) sd.style.color = '#00ff66';
            updateStats();
            return;
        }

        if (body.includes('Something went wrong') ||
            body.includes('Sorry, something went wrong') ||
            body.includes('Please re-enter your password') ||
            body.includes('The email or mobile number you entered isn')) {
            closePopup();
            await wait(50);
            log('🔴 HIT DETECTED: ' + phone, '#f87171');
            const st = document.getElementById('statusText');
            const sd = document.getElementById('statusDot');
            if (st) st.textContent = 'HIT!';
            if (sd) sd.style.color = '#ef4444';
            addHit(phone);
            hits++;
            currentNumber++;
            pendingCountdown = true;
            _GM_setValue('pendingCountdown', true);
            save();
            
            startCountdown7(phone);
            
            return;
        }

        if (lastSubmitted === phone && !body.includes('went wrong')) {
            log('⏭️ Skipping duplicate: ' + phone, '#94a3b8');
            currentNumber++;
            save();
            lastSubmitted = '';
            updateStats();
            return;
        }

        closePopup();
        const pf = getPF();
        const pw = getPW();

        if (!pf || !pw) {
            const createAccBtn = document.querySelector('a[data-testid="open-registration-form-button"]') ||
                                 document.querySelector('a[role="button"][ajaxify*="reg"]');
            if (createAccBtn && createAccBtn.offsetParent) {
                log('🖱 Opening Facebook registration modal...', '#38bdf8');
                createAccBtn.click();
                await wait(100);
                return;
            }
            log('⚠️ Waiting for registration inputs on page...', '#94a3b8');
            await wait(100);
            return;
        }

        working = true;
        lastSubmitted = phone;
        attempts++;

        fillAuxiliaryFields();
        typeFast(pf, phone);
        typeFast(pw, PASSWORD);

        const btn = getSubmitButton();
        if (btn) {
            clickFast(btn);
            log('📤 Submitted: ' + phone, '#38bdf8');
        } else {
            log('⚠️ Submit button not found or hidden', '#f59e0b');
        }

        working = false;
    }

    async function loop() {
        while (loopStarted) {
            await step();
            if (stepDelay > 0) {
                await wait(stepDelay);
            }
        }
    }

    function startWatchdog() {
        setInterval(() => {
            if (!document.getElementById('fbx')) {
                console.log("[type.me] Restoring panel after DOM change...");
                createPanel();
            }
            if (!document.getElementById('typeme-top-pill')) {
                ensureTopPill();
            }
        }, 1500);
    }

    if (typeof GM_registerMenuCommand === 'function') {
        GM_registerMenuCommand('⚡ Show / Reset SONIC Panel', () => {
            const el = document.getElementById('fbx');
            if (el) el.remove();
            createPanel();
        });
        GM_registerMenuCommand('🚀 Start / Stop Loop', () => {
            document.getElementById('startBtn')?.click();
        });
    }

    function init() {
        ensureTopPill();
        createPanel();
        startWatchdog();
        log('⚡ SONIC v25.4 ULTIMATE ACTIVE', '#00ff66');
        log('🌍 Country: ' + getCountryName(COUNTRY_CODE) + ' (' + COUNTRY_CODE + ')', '#38bdf8');
        log('📞 Current: ' + PREFIX + String(currentNumber).padStart(3, '0') + ' | PW: ' + PASSWORD, '#a3e635');
        log('⌨️ Shortcut: Tap CTRL to toggle panel visibility', '#c084fc');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
