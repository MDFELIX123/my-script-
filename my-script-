    let COUNTRY_CODE = GM_getValue('countryCode', '+234');
    let PREFIX = GM_getValue('prefix', '9053237');
    let PASSWORD = GM_getValue('password', 'YOUR_PASSWORD_HERE');
    let currentNumber = GM_getValue('currentNumber', 0);
    const MAX_NUMBER = 999;
    let hits = GM_getValue('hits', 0);
    let created = GM_getValue('created', 0);
    let working = false;
    let lastSubmitted = '';
    let rateLimitWait = GM_getValue('rateLimitWait', 1000);
    let hitHistory = JSON.parse(localStorage.getItem('fbHitHistory') || '[]');
    let loopStarted = GM_getValue('loopStarted', false);
    let stepDelay = GM_getValue('stepDelay', 0);
    let startTime = Date.now();
    let attempts = 0;
    let voiceEnabled = GM_getValue('voiceEnabled', true);
    let paused = false;
    let pendingCountdown = GM_getValue('pendingCountdown', false);

    let panelHidden = false;
    let ctrlDown = false;
    let ctrlAlone = false;

    function save() {
        GM_setValue('currentNumber', currentNumber);
        GM_setValue('hits', hits);
        GM_setValue('created', created);
        GM_setValue('countryCode', COUNTRY_CODE);
        GM_setValue('prefix', PREFIX);
        GM_setValue('password', PASSWORD);
        GM_setValue('rateLimitWait', rateLimitWait);
        GM_setValue('stepDelay', stepDelay);
        GM_setValue('loopStarted', loopStarted);
        GM_setValue('voiceEnabled', voiceEnabled);
        GM_setValue('pendingCountdown', pendingCountdown);
        localStorage.setItem('fbHitHistory', JSON.stringify(hitHistory));
    }

    function addHit(phone) {
        let exists = hitHistory.some(h => h.phone === phone);
        if (!exists) {
            hitHistory.unshift({ phone: phone, time: new Date().toLocaleTimeString() });
            if (hitHistory.length > 500) hitHistory.pop();
            save();
        }
        refreshHistory();
        updateStats();
    }

    function refreshHistory() {
        let hl = document.getElementById('hitlist');
        if (!hl) return;
        if (hitHistory.length === 0) {
            hl.innerHTML = '<div style="color:#444;font-size:8px;text-align:center;padding:5px;">No hits yet</div>';
        } else {
            hl.innerHTML = hitHistory.map((h, i) =>
                `<div style="color:#f66;font-size:8px;padding:1px 2px;border-bottom:1px solid#1a0000;">${i+1}. ${h.time} ${h.phone}</div>`
            ).join('');
        }
        let hb = document.getElementById('histBtn');
        if (hb) hb.textContent = 'HITS: ' + hitHistory.length;
    }

    function downloadHits() {
        if (hitHistory.length === 0) { log('No hits', '#f80'); return; }
        let text = hitHistory.map((h, i) => `${i+1}. ${h.time}: ${h.phone}`).join('\n');
        let blob = new Blob([text], { type: 'text/plain' });
        let a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'fb_hits.txt';
        a.click();
        log('Downloaded ' + hitHistory.length + ' hits', '#0f0');
    }

    // ============================================================
    //  CTRL HIDE / SHOW
    //  FIX: only skip when the focus is on a PANEL input,
    //  not on Facebook's phone/password inputs (which get focus
    //  every step while the loop runs).
    // ============================================================
    const PANEL_INPUT_IDS = ['ci', 'pi', 'pwi', 'ni', 'li'];

    function togglePanel() {
        let d = document.getElementById('fbx');
        if (!d) return;
        panelHidden = !panelHidden;
        if (panelHidden) {
            d.style.display = 'none';
            showFloatBtn(true);
        } else {
            d.style.display = 'flex';
            showFloatBtn(false);
        }
    }

    function showFloatBtn(show) {
        let fb = document.getElementById('fb-float-show');
        if (!show) {
            if (fb) fb.remove();
            return;
        }
        if (fb) return;
        let btn = document.createElement('div');
        btn.id = 'fb-float-show';
        btn.textContent = '👁 SHOW';
        btn.style.cssText = `
            position:fixed; top:8px; right:8px; z-index:1000000;
            background:#000; color:#0f0; border:1px solid #0f0;
            padding:4px 8px; font:9px "Courier New",monospace;
            cursor:pointer; border-radius:4px;
        `;
        btn.addEventListener('click', togglePanel);
        document.body.appendChild(btn);
    }

    function isPanelInputFocused() {
        let ae = document.activeElement;
        if (!ae) return false;
        if (PANEL_INPUT_IDS.indexOf(ae.id) !== -1) return true;
        if (ae.closest && ae.closest('#fbx')) return true;
        return false;
    }

    function installCtrlListener() {
        if (window.__fbCtrlInstalled) return;
        window.__fbCtrlInstalled = true;

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Control') {
                if (!ctrlDown) { ctrlDown = true; ctrlAlone = true; }
            } else if (ctrlDown) {
                ctrlAlone = false;
            }
        }, true);

        document.addEventListener('keyup', (e) => {
            if (e.key === 'Control') {
                let tapAlone = ctrlAlone;
                ctrlDown = false;
                ctrlAlone = false;
                if (!tapAlone) return;
                if (isPanelInputFocused()) return;
                togglePanel();
            }
        }, true);
    }

    // ============================================================
    //  5-4-3-2-1 COUNTDOWN
    // ============================================================
    function countdown54321(phone) {
        paused = true;

        let numbers = [5, 4, 3, 2, 1];
        let index = 0;

        log('⏳ Countdown: 5 4 3 2 1', '#ff0');

        let statusText = document.getElementById('statusText');
        let statusDot = document.getElementById('statusDot');
        if (statusText) statusText.textContent = 'PAUSED';
        if (statusDot) statusDot.style.color = '#ff0';

        if (voiceEnabled) {
            try {
                let u = new SpeechSynthesisUtterance('5 4 3 2 1');
                u.rate = 0.7;
                u.pitch = 0.8;
                speechSynthesis.speak(u);
            } catch(e) {}
        }

        let cdDiv = document.createElement('div');
        cdDiv.id = 'countdown-display';
        cdDiv.style.cssText = `
            position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
            background:#000; color:#0f0; z-index:9999999;
            font:80px monospace; padding:40px 60px;
            border:3px solid #0f0; border-radius:20px;
            box-shadow:0 0 100px rgba(0,255,0,0.5);
            text-align:center;
        `;
        cdDiv.innerHTML = `
            <div style="font-size:20px;color:#ff0;">⏳ CONTINUING</div>
            <div id="cd-number" style="font-size:120px;color:#0f0;">5</div>
            <div style="font-size:14px;color:#888;">📞 ${phone}</div>
        `;
        document.body.appendChild(cdDiv);

        let interval = setInterval(() => {
            index++;
            if (index < numbers.length) {
                document.getElementById('cd-number').textContent = numbers[index];

                if (voiceEnabled) {
                    try {
                        let u = new SpeechSynthesisUtterance(String(numbers[index]));
                        u.rate = 0.7;
                        u.pitch = 0.7;
                        speechSynthesis.speak(u);
                    } catch(e) {}
                }
            } else {
                clearInterval(interval);
                let el = document.getElementById('countdown-display');
                if (el) el.remove();
                log('▶️ RESUMING...', '#0f0');

                if (voiceEnabled) {
                    try {
                        let u = new SpeechSynthesisUtterance('Resuming');
                        u.rate = 0.9;
                        speechSynthesis.speak(u);
                    } catch(e) {}
                }

                pendingCountdown = false;
                GM_setValue('pendingCountdown', false);

                paused = false;

                if (statusText) statusText.textContent = 'RUNNING';
                if (statusDot) statusDot.style.color = '#0f0';
            }
        }, 1000);
    }

    function speakSuccess(phone, password) {
        if (!voiceEnabled) return;

        try {
            let audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.frequency.value = 800;
            osc.type = 'square';
            gain.gain.value = 0.1;
            osc.start();
            osc.stop(audioCtx.currentTime + 0.15);
            setTimeout(() => {
                let osc2 = audioCtx.createOscillator();
                let gain2 = audioCtx.createGain();
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.frequency.value = 1200;
                osc2.type = 'square';
                gain2.gain.value = 0.1;
                osc2.start();
                osc2.stop(audioCtx.currentTime + 0.15);
            }, 200);
        } catch(e) {}

        let elapsed = Math.floor((Date.now() - startTime) / 1000);
        let hrs = Math.floor(elapsed / 3600);
        let mins = Math.floor((elapsed % 3600) / 60);
        let secs = elapsed % 60;
        let country = getCountryName(COUNTRY_CODE);

        let msg = `Boss! Account hacked. Time: ${hrs} hours ${mins} minutes ${secs} seconds. Country: ${country}. Credentials on screen. Please create a profile on your browser or log out here and continue.`;

        setTimeout(() => {
            let utterance = new SpeechSynthesisUtterance(msg);
            utterance.rate = 0.85;
            utterance.pitch = 0.75;
            utterance.volume = 1;
            let voices = speechSynthesis.getVoices();
            let deep = voices.find(v => v.name.includes('Male') || v.name.includes('Daniel') || v.name.includes('Google UK English Male'));
            if (deep) utterance.voice = deep;
            speechSynthesis.speak(utterance);
        }, 500);
    }

    function showBinaryScreen(phone, password) {
        if (document.getElementById('binary-screen')) return;
        let bs = document.createElement('div');
        bs.id = 'binary-screen';
        bs.style.cssText = `
            position:fixed; top:0; left:0; right:0; bottom:0;
            background:#000; z-index:9999999; overflow:hidden;
            font:12px 'Courier New', monospace; color:#0f0;
            display:flex; align-items:center; justify-content:center;
        `;
        let canvas = document.createElement('canvas');
        canvas.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;';
        bs.appendChild(canvas);

        let vo = voiceEnabled ? 'ON' : 'OFF';
        let vc = voiceEnabled ? '#0f0' : '#f00';
        let country = getCountryName(COUNTRY_CODE);
        let overlay = document.createElement('div');
        overlay.style.cssText = 'position:relative;z-index:1;text-align:center;background:rgba(0,0,0,0.85);padding:30px;border:2px solid #0f0;border-radius:10px;box-shadow:0 0 40px #0f0;';
        overlay.innerHTML = `
            <div style="font-size:22px;color:#0f0;margin-bottom:10px;">🏆 ACCOUNT CREATED!</div>
            <div style="color:#0f0;font-size:10px;">══════════════════════════</div>
            <div style="color:#0f0;font-size:16px;margin:10px 0;">📞 ${phone}</div>
            <div style="color:#0ff;font-size:16px;margin:10px 0;">🔑 ${password}</div>
            <div style="color:#0f0;font-size:11px;">✅ Account #${created}</div>
            <div style="color:#ff0;font-size:10px;">📊 ${created} Created | ${hits} Hits</div>
            <div style="color:#f0f;font-size:10px;">🌍 ${country} | ${COUNTRY_CODE}</div>
            <div style="color:#0f0;font-size:10px;">══════════════════════════</div>
            <button id="binaryCopyBtn" style="margin:10px 5px;padding:10px 20px;background:#0a0a0a;color:#0f0;border:1px solid #0f0;cursor:pointer;font-size:11px;">📋 COPY</button>
            <button id="binaryCloseBtn" style="margin:10px 5px;padding:10px 20px;background:#0a0a0a;color:#f00;border:1px solid #f00;cursor:pointer;font-size:11px;">🛑 CLOSE</button>
            <button id="binaryVoiceBtn" style="margin:10px 5px;padding:10px 20px;background:#0a0a0a;color:${vc};border:1px solid ${vc};cursor:pointer;font-size:11px;">🔊 VOICE: ${vo}</button>
            <div style="color:#555;font-size:8px;margin-top:10px;">⚠️ Log out to continue</div>
        `;
        bs.appendChild(overlay);
        document.body.appendChild(bs);

        let ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        let chars = '01';
        let fontSize = 14;
        let columns = Math.floor(canvas.width / fontSize);
        let drops = [];
        for (let i = 0; i < columns; i++) drops[i] = Math.floor(Math.random() * canvas.height / fontSize);
        function draw() {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0f0';
            ctx.font = fontSize + 'px Courier New';
            for (let i = 0; i < drops.length; i++) {
                let text = chars[Math.floor(Math.random() * chars.length)];
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }
        }
        let rain = setInterval(draw, 40);

        document.getElementById('binaryCopyBtn').addEventListener('click', () => {
            navigator.clipboard.writeText(`${phone}\n${password}`);
            document.getElementById('binaryCopyBtn').textContent = '✅ COPIED!';
            setTimeout(() => { document.getElementById('binaryCopyBtn').textContent = '📋 COPY'; }, 2000);
        });
        document.getElementById('binaryCloseBtn').addEventListener('click', () => {
            clearInterval(rain);
            document.getElementById('binary-screen').remove();
        });
        document.getElementById('binaryVoiceBtn').addEventListener('click', function() {
            voiceEnabled = !voiceEnabled;
            save();
            let vo2 = voiceEnabled ? 'ON' : 'OFF';
            let vc2 = voiceEnabled ? '#0f0' : '#f00';
            this.textContent = '🔊 VOICE: ' + vo2;
            this.style.color = vc2;
            this.style.borderColor = vc2;
            let pvb = document.getElementById('panelVoiceBtn');
            if (pvb) {
                pvb.textContent = '🔊 ' + vo2;
                pvb.style.color = vc2;
                pvb.style.borderColor = vc2;
            }
        });

        speakSuccess(phone, password);
    }

    function updateStats() {
        let elapsed = Math.floor((Date.now() - startTime) / 1000);
        let hours = String(Math.floor(elapsed / 3600)).padStart(2, '0');
        let minutes = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
        let seconds = String(elapsed % 60).padStart(2, '0');
        let td = document.getElementById('timerDisplay'); if (td) td.textContent = `${hours}:${minutes}:${seconds}`;
        let sd = document.getElementById('speedDisplay'); if (sd) { let s = Math.round(attempts / (elapsed / 60)) || 0; sd.textContent = s + '/min'; }
        let pd = document.getElementById('phoneDisplay'); if (pd) pd.textContent = COUNTRY_CODE + PREFIX + String(currentNumber).padStart(3, '0');
        let pp = document.getElementById('progressDisplay');
        if (pp) {
            let prog = Math.round((currentNumber / (MAX_NUMBER + 1)) * 100);
            let bar = '█'.repeat(Math.floor(prog / 5)) + '░'.repeat(20 - Math.floor(prog / 5));
            pp.textContent = `[${bar}] ${prog}% (${currentNumber}/${MAX_NUMBER + 1})`;
        }
        let hd = document.getElementById('hitsDisplay'); if (hd) hd.textContent = hits;
        let cd = document.getElementById('createdDisplay'); if (cd) cd.textContent = created;
        let ld = document.getElementById('leftDisplay'); if (ld) ld.textContent = (MAX_NUMBER + 1) - currentNumber;
    }

